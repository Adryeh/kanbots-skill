{
  "name": "kanbots-skill",
  "version": "0.2.2",
  "description": "Kanban-for-Agents skill — Claude Code plugin, Codex plugin, and portable SKILL.md.",
  "license": "MIT",
  "repository": "git+https://github.com/Adryeh/kanbots-skill.git",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__kanban__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/enforce-agent-name.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/auto-extend-claim.py"
          }
        ]
      }
    ]
  }
}
